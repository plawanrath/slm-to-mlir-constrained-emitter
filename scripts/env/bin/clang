#!/usr/bin/env bash
# clang from the pinned LLVM, via the same long-lived container. Used for the
# `clang -emit-llvm + mlir-translate` fallback path in the L1 Polygeist pipeline.
set -euo pipefail
CONTAINER="${SLM_MLIR_CONTAINER:-slm-mlir-llvm}"
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER}$"; then
    echo "error: container '${CONTAINER}' not running." >&2
    exit 127
fi
exec docker exec -i -w /work "${CONTAINER}" clang "$@"
