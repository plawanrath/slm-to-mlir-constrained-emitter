#!/usr/bin/env bash
# Polygeist wrapper. Binary is named `polygeist` inside the container
# (installed to /opt/llvm/bin/polygeist during the Docker build).
set -euo pipefail
CONTAINER="${SLM_MLIR_CONTAINER:-slm-mlir-llvm}"
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER}$"; then
    echo "error: container '${CONTAINER}' not running." >&2
    exit 127
fi
exec docker exec -i -w /work "${CONTAINER}" polygeist "$@"
